# Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# .env asla commit edilmez.

# --- Django ---
# Uretmek icin:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Veritabani ---
# Supabase > Project Settings > Database > Connection string > Transaction pooler
# DIKKAT: port 6543 (pooler), 5432 degil.
# Bos birakilirsa gelistirmede yerel sqlite kullanilir.
DATABASE_URL=

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Oylama ---
# Ziyaretci oy token'lari icin IP hash tuzu. Rastgele uzun bir dize.
VOTER_TOKEN_SALT=

# --- JWT ---
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# --- Izleme (opsiyonel) ---
SENTRY_DSN=
